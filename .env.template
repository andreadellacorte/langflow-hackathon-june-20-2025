# eMCeeP Environment Configuration
# Copy this file to .env and fill in your actual API keys

# AI API Keys
OPENAI_API_KEY=your_openai_key_optional

# Twilio Configuration  
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Event Data
EVENT_DATA_PATH=./data/event.json

# Langflow Settings
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860

# Demo Configuration
DEMO_ORGANIZER_PHONE=+1555123456
DEMO_ATTENDEE_PHONES=+1234567890,+1234567891,+1234567892

# Optional: Webhook URLs for advanced integration
WEBHOOK_BASE_URL=http://localhost:8000
ESCALATION_WEBHOOK_URL=${WEBHOOK_BASE_URL}/escalate

# Logging
LOG_LEVEL=INFO 